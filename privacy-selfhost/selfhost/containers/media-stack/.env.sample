# Replace this placeholder locally with the full value after `PrivateKey =`
# in your Proton VPN WireGuard configuration. Do not commit or share this file.
PROTON_WG_PRIVATE_KEY=REPLACE_WITH_YOUR_PRIVATE_KEY
PUID=1000
PGID=1000
TZ=UTC
DOCKER_SUBNET=172.18.0.0/16

# Adapt this
ROUTER_SUBNET=10.165.161.0/24

# Use getent group video / render
VIDEO=49
RENDER=992

# Use v4l2-ctl --list-devices
VIDEO_DEVICE=video19
