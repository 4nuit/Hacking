// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "context_servers": {
    "mcp-server-playwright": {
      "enabled": true,
      "remote": false,
      "settings": {
      "browser": "chromium",
      "headless": false,
      "vision": true}
    }
  },
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "sticky_scroll": {
    "enabled": true
  },
  "project_panel": {},
  "outline_panel": {},
  "collaboration_panel": {},
  "git_panel": {},
  "ui_font_weight": 400.0,
  "semantic_tokens": "combined",
  "scrollbar": {
    "show": "never"
  },
  "agent_buffer_font_size": 11.0,
  "ui_font_family": "Ioskeley Mono",
  "node": {
    "ignore_system_version": true
  },
  "colorize_brackets": false,

  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "buffer_font_family": "Maple Mono",
  "buffer_font_features": {
    "liga": true,
    "calt": true,
    "ss01": true,
    "ss02": false
  },
  "buffer_line_height": "standard",
  "ui_font_size": 14.0,
  "buffer_font_size": 14.0,
  // The weight of the editor font in standard CSS units from 100 to 900.
  "buffer_font_weight": 400.0,
  "text_rendering_mode": "platform_default",

  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          // Let each project's pyproject.toml control line-length
          "lint": {
            "extendSelect": ["I"]
          }
        }
      }
    }
  },

  "languages": {
    "Python": {
      "language_servers": ["ruff", "pyrefly"],
      "format_on_save": "on",
      "formatter": [
        {
          "code_action": "source.organizeImports.ruff"
        },
        {
          "code_action": "source.fixAll.ruff"
        },
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ]
    },
    "Markdown": {
      "language_servers": ["marksman"]
    }
  },
  "title_bar": {
    // Show/hide sign-in button
    "show_sign_in": false
  },
  "cursor_blink": true,
  "cursor_shape": "bar",
  "hide_mouse": "on_typing",
  "selection_highlight": true,
  // Visually show tabs and spaces  (none, all, selection, boundary, trailing)
  "show_whitespaces": "selection",
  "whitespace_map": {
    // Which characters to show when `show_whitespaces` enabled
    "space": "•",
    "tab": "⟶" // use "→", for a shorter arrow
  },
  "git": {
    "inline_blame": {
      "enabled": false, // Show/hide inline blame
      "delay_ms": 0, // Show after delay (ms)
      "min_column": 0, // Minimum column to inline display blame
      "padding": 7, // Padding between code and inline blame (em)
      "show_commit_summary": false // Show/hide commit summary
    },
    "hunk_style": "staged_hollow" // staged_hollow, unstaged_hollow
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "fast": true
      },
      "type": "registry"
    },
    "qwen-code": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "kimi": {
      "type": "registry"
    },
    "kilo": {
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "cline": {
      "type": "registry"
    },
    "reasonix": {
      "type": "custom",
      "command": "npx",
      "args": ["reasonix", "acp"],
      "env": {}
    }
  },
  "icon_theme": "VSCode Icons for Zed (Dark Official Icons)",
  "terminal": {
    "scrollbar": {
      "show": "never"
    },
    "font_family": "MesloLGS NF",
    "font_size": 12.0,
    // Set the cursor blinking behavior in the terminal (on, off, terminal_controlled)
    "blinking": "on",
    // Default cursor shape for the terminal cursor (block, bar, underline, hollow)
    "cursor_shape": "block"
  },
  "agent": {
    "max_content_width": 853.0,
    "enable_feedback": false,
    "play_sound_when_agent_done": "when_hidden",
    "tool_permissions": {
      "default": "allow"
    },
    "default_profile": "write",
    "default_model": {
      "enable_thinking": false,
      "provider": "anthropic",
      "model": "claude-opus-4-6-1m-context-latest"
    }
  },
  "agent_ui_font_size": 13.0,

  "base_keymap": "VSCode",
  "theme": {
    "mode": "dark",
    "light": "Firefox Quantum Light",
    "dark": "Mixtape Dark Vaporwave - 04 - Blank Banshee (Transparent)"
  },

  // ───────────────────────────────────────────────────────────────────────
  // Mixtape — unified typography overrides.
  //
  // Colors are owned by each theme; weights and italics are owned here so
  // the whole collection (15 dark + 10 light = 25 themes)
  // reads identically regardless of palette.
  //
  // Italics (semantic emphasis):
  //   keyword               if, for, class, return, async, await, import…
  //   type, type.builtin, type.interface, type.super
  //                         user types + int/str/bool/String/Vec…
  //   constant.builtin      None, null, nil, undefined, NULL
  //   boolean               True/False, true/false
  //
  // Weights:
  //   emphasis.strong 700   markdown **bold**
  //   title           700   markdown headings
  //   hint            700   inlay hints — anchored for long sessions
  //   variable*       500   default body identifier weight (was 400)
  //   string*, text.literal 400   relaxed, legible string bodies
  // ───────────────────────────────────────────────────────────────────────
  "theme_overrides": {
    // theme inspiration: "Dark Plus Chocolate by Moondevaa, Ayu by Ike Ku, Materialize by Saad Quadri"
