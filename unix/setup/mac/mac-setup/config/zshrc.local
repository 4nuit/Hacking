#!/usr/bin/env zsh
# ===============================================================
#  ~/.zshrc.local — your personal shell config
# ===============================================================
#
#  omacosy's zshrc sources this file at its line 20. The repo does not
#  manage it. It survives omacosy-update. It does not make the clone
#  dirty.
#
#  LOAD ORDER
#    ~/.zshrc  ->  omacosy zsh/zshrc  ->  THIS FILE  ->  omacosy CLI
#    stack (fzf, eza, zoxide, ripgrep, bat, lazygit, btop)
#
#    The CLI stack loads after this file on purpose. Anything of theirs
#    that you redefine here gets overridden again. This is why the eza
#    alias and the zoxide init are not in this file.
#
#  THE ORDER OF THE LINES IS PART OF THE CONFIG
#    A later PATH export wins. Two rules must not move:
#      1. pnpm comes after fnm (section 5). If pnpm comes first, fnm's
#         bundled pnpm 9 hides your pnpm 11.
#      2. syntax-highlighting comes last (section 6). It wraps the line
#         editor and breaks if another plugin starts after it.
#
#  Do not put `exec zsh` in this file. It loops forever. You get a bare
#  prompt and no error message.
#
#  To debug a hang:
#    zsh -n ~/.zshrc.local
#    zsh -x -c 'source ~/.zshrc.local' 2>&1 | tail -20
# ===============================================================


# ---------------------------------------------------------------
#  1. PATH
# ---------------------------------------------------------------
#
#  Never write this line here:
#    export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
#  It resets PATH from nothing. That is correct in the first line of a
#  standalone .zshrc. It is destructive here, because this file loads
#  in the middle of omacosy's zshrc and would delete everything set
#  before it. Only append.
#
#  There is also no `brew shellenv` line here. omacosy's zshrc runs it.
#  Check with:  grep -n shellenv ~/.zshrc
#  If it ever stops, remove the # from the next line.
# eval "$(/opt/homebrew/bin/brew shellenv)"

# Language toolchains and your own binaries.
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# Optional paths. Each line is active only if the directory exists, so
# an unused entry costs nothing. Delete what you do not want.
[ -d "/opt/homebrew/opt/tcl-tk/bin" ]   && export PATH="/opt/homebrew/opt/tcl-tk/bin:$PATH"
[ -d "/usr/local/mysql/bin" ]           && export PATH="/usr/local/mysql/bin:$PATH"

# Databases.
#
# Homebrew calls sqlite and the versioned postgresql formulae keg-only.
# It installs them but does not link their commands into
# /opt/homebrew/bin, because macOS already has an sqlite3 in /usr/bin.
# These two blocks put the Homebrew copies first.
[ -d "/opt/homebrew/opt/sqlite/bin" ] && export PATH="/opt/homebrew/opt/sqlite/bin:$PATH"

# postgresql@17, postgresql@18 and so on. Pick the highest number
# present. (Nn) is a zsh glob qualifier: N means an empty match is not
# an error, n sorts the result by the number in the name. This runs in
# the shell itself, with no extra process.
_pg_bins=(/opt/homebrew/opt/postgresql@*/bin(Nn))
(( ${#_pg_bins} )) && export PATH="${_pg_bins[-1]}:$PATH"
unset _pg_bins

# The mysql formula is not keg-only, so /opt/homebrew/bin already holds
# mysql and mysqladmin. The /usr/local/mysql/bin line above is for the
# separate installer from oracle.com, which puts them somewhere else.

# Android. The android-commandlinetools and android-platform-tools casks
# install the SDK. Appended, so the order inside this block does not
# matter.
export ANDROID_HOME="$HOME/Library/Android/sdk"
[ -d "$ANDROID_HOME" ] && export PATH="$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools"
[ -d "$HOME/.cache/lm-studio/bin" ] && export PATH="$PATH:$HOME/.cache/lm-studio/bin"

#  fnm and pnpm are not in this section. They must load after compinit,
#  and in a fixed order relative to each other. See section 5.


# ---------------------------------------------------------------
#  2. Environment
# ---------------------------------------------------------------

# Prompt. This is your own copy of the starship config. The default
# path (~/.config/starship.toml) is a symlink into the omacosy clone.
# Editing that file blocks omacosy-update.
export STARSHIP_CONFIG="$HOME/.config/starship-mine.toml"

# tcl-tk, for Homebrew Python builds.
if [ -d "/opt/homebrew/opt/tcl-tk" ]; then
  export LDFLAGS="-L/opt/homebrew/opt/tcl-tk/lib"
  export CPPFLAGS="-I/opt/homebrew/opt/tcl-tk/include"
  export PKG_CONFIG_PATH="/opt/homebrew/opt/tcl-tk/lib/pkgconfig"
fi

# Remove anything that would interfere with Homebrew Python.
unset PYTHONPATH

# The editor that git, less and other programs open. Change nvim to
# vim, or to "zed --wait", if you prefer one of those.
export EDITOR="nvim"
export VISUAL="$EDITOR"

export TORCH_DEVICE=mps
export HOMEBREW_INSTALL_CLEANUP=1


# ---------------------------------------------------------------
#  3. History
# ---------------------------------------------------------------

HISTFILE=$HOME/.zhistory
SAVEHIST=1000
HISTSIZE=999

setopt share_history           # shared between open terminals
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify             # expand !! first, do not run it blind


# ---------------------------------------------------------------
#  4. Key bindings
# ---------------------------------------------------------------

# The arrow keys search the history for what you already typed.
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward


# ---------------------------------------------------------------
#  5. Completions and version managers
# ---------------------------------------------------------------
#
#  compinit must run before the plugins in section 6.
#  A stale ~/.zcompdump makes startup slow or makes the shell hang.
#  Delete the file and zsh builds a new one.

[ -d "$HOME/.docker/completions" ] && fpath=("$HOME/.docker/completions" $fpath)
autoload -Uz compinit
compinit

# -- Node ------------------------------------------------------
#  fnm puts its shim directory at the front of PATH. Anything that must
#  win against fnm has to come after this line. Do not move pnpm above
#  it.
#
#  If you do move it, `pnpm update -g` fails with:
#    ERR_PNPM_NO_PKG_MANIFEST  No package.json found in .../global/5
#  because fnm's bundled pnpm 9 uses the global/5 store layout, and your
#  packages live in global/v11. Diagnose with `which -a pnpm`.
#
#  --use-on-cd switches Node when you enter a directory that holds an
#  .nvmrc or a .node-version file. Do not pin a Node version by hand. A
#  hardcoded node-versions/vNN path defeats the switching.

command -v fnm >/dev/null && eval "$(fnm env --use-on-cd)"

#  pnpm, after fnm. $PNPM_HOME itself is pnpm's global bin directory.
#  $PNPM_HOME/bin holds pnpm's own programs. Both must be on PATH. With
#  only /bin you get "The configured global bin directory is not in
#  PATH".
export PNPM_HOME="$HOME/Library/pnpm"
export PATH="$PNPM_HOME:$PNPM_HOME/bin:$PATH"


# ---------------------------------------------------------------
#  6. zsh plugins
# ---------------------------------------------------------------
#
#  Check whether omacosy already loads these before you add more:
#    grep -nE "autosuggestions|syntax-highlighting" ~/.zshrc
#  Loading them twice does no damage. It only makes startup slower.
#
#  syntax-highlighting must be last. It wraps the line editor and breaks
#  if another plugin starts after it.

[ -r /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && \
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[ -r /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && \
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh


# ---------------------------------------------------------------
#  7. Aliases
# ---------------------------------------------------------------

alias python="python3"
alias pip="pip3"

# Clean up Homebrew after topgrade finishes.
alias topgrade='command topgrade && brew cleanup --prune=all -s && /bin/rm -rf ~/Library/Caches/Homebrew/downloads/*'

# Use pnpm, not npm.
alias npm="echo 'Use pnpm instead' && false"
alias npx="echo 'Use pnpm dlx instead' && false"


# ---------------------------------------------------------------
#  8. Move installer lines out of ~/.zshrc automatically
# ---------------------------------------------------------------
#
#  Installers append to ~/.zshrc, because that is the usual path. This
#  hook moves what they add into this file. You never have to check or
#  move anything by hand.
#
#  It runs once per shell, after the shell finishes reading its config.
#  Rewriting ~/.zshrc while zsh reads it is not safe, so the move takes
#  effect in the next shell. The current shell already ran those lines,
#  so nothing is missing either way.
#
#  Needs:     ~/.local/bin/omacosy-harvest-zshrc  (chmod +x)
#  Backups:   ~/.local/state/omacosy-harvest/
#  To stop:   put a # in front of the add-zsh-hook line below.

if [ -x "$HOME/.local/bin/omacosy-harvest-zshrc" ]; then
  _omacosy_harvest_once() {
    add-zsh-hook -d precmd _omacosy_harvest_once   # run once, then unhook
    "$HOME/.local/bin/omacosy-harvest-zshrc"
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _omacosy_harvest_once
fi


# ===============================================================
#  Notes on what is not here
# ===============================================================
#
#  powerlevel10k. omacosy uses starship. Two prompts fight over PROMPT.
#  To go back to p10k, remove the # from these two lines. They load
#  after starship, so p10k wins, because it sets PROMPT last:
# source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme
# [[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
#
#  oh-my-zsh. omacosy is plain zsh. Its zshrc loads the CLI stack after
#  this file on purpose, so oh-my-zsh can load here safely. Drop
#  ZSH_THEME in any case, because starship owns the prompt.
# export ZSH="$HOME/.oh-my-zsh"
# plugins=(git)
# source $ZSH/oh-my-zsh.sh
#
#  alias ls="eza --icons=always"           omacosy wires eza
#  eval "$(zoxide init zsh --cmd cd)"      omacosy wires zoxide
#
#  Two lines that installers add and that you must delete if you see
#  them, because both bring back the pnpm bug in section 5:
#    eval "$(fnm env --use-on-cd --shell zsh)"      runs fnm after pnpm
#    export PATH=".../node-versions/v24.20.0/installation/bin:$PATH"
#                                                   pins one Node version
